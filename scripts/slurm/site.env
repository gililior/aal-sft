# Cluster-specific defaults, sourced by the Slurm scripts. Any variable already set
# in the environment wins. Edit for another cluster.
SITE_BASE=/cs/snapless/gabis/gililior
VENV=${VENV:-$SITE_BASE/virtual_envs/aal_sft}

# Home directories have small quotas: keep every large cache on project storage.
export HF_HOME=${HF_HOME:-$SITE_BASE/hf_cache}                 # model weights (~9 GB for 4B)
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$SITE_BASE/.cache}     # vLLM, pip, misc (~/.cache)
export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$SITE_BASE/.cache/triton}   # compiled GPU kernels
export PIP_CACHE_DIR=${PIP_CACHE_DIR:-$SITE_BASE/.cache/pip}
export UV_CACHE_DIR=${UV_CACHE_DIR:-$SITE_BASE/.cache/uv}

TRAIN_GRES=${TRAIN_GRES:-gpu:l40s:4}
EVAL_GRES=${EVAL_GRES:-gpu:l40s:1}
TRAIN_TIME=${TRAIN_TIME:-24:00:00}
EVAL_TIME=${EVAL_TIME:-12:00:00}
